# MongoDB connection string.
# Create .env.local file and add your MongoDB connection string to it.
# Replace <username> and <password> with your actual MongoDB credentials.

MONGODB_URI=mongodb+srv://<username>:<password>@a11y-advent-calendar.n119xuf.mongodb.net/a11y-advent-calendar

# BetterAuth configuration.
# Create .env.local file and add your BetterAuth secret and URL to it.
# Replace YOUR-PASSWORD with your actual BetterAuth secret.
BETTER_AUTH_SECRET=YOUR-PASSWORD
BETTER_AUTH_URL=http://localhost:3000
